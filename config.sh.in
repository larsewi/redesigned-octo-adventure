#!/usr/bin/env sh
#
# config.sh.  Generated from config.sh.in by configure.
#

# System type variables from AC_CANONICAL_HOST
export HOST_CPU="@host_cpu@"
export HOST_OS="@host_os@"
export CPU_COUNT="@CPU_COUNT@"

# Project paths (optional)
@LOCAL_CORE_PATH@
@LOCAL_MASTERFILES_PATH@
@LOCAL_ENTERPRISE_PATH@
@LOCAL_NOVA_PATH@
@LOCAL_MISSION_PORTAL_PATH@

# Programs
export RSYNC="@RSYNC@"
export MAKE="@MAKE@"
export FUSER="@FUSER@"
export PATCH="@PATCH@"
