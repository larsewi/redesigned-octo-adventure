AT_INIT
AT_COLOR_TESTS

########################################
AT_SETUP([Test logging functions])
########################################

. "$abs_top_builddir"/src/utils.sh
AT_CHECK([log_debug "Hello World!"], 0, [testsuite: debug: Hello World!
])
AT_CHECK([log_info "Hello World!"], 0, [testsuite: info: Hello World!
])
AT_CHECK([log_error "Hello World!"], 0, [], [testsuite: error: Hello World!
])

########################################
AT_CLEANUP
########################################

########################################
AT_SETUP([Test config.sh])
########################################

. "$abs_top_builddir"/src/config.sh
AT_CHECK([test -n "$OS_NAME"], 0)
AT_CHECK([test -n "$OS_VERSION"], 0)
AT_CHECK([test -n "$CPU_COUNT"], 0)

AT_CHECK([grep -q "export CORE_PATH=" "$abs_top_builddir"/src/config.sh])
AT_CHECK([grep -q "export MASTERFILES_PATH=" "$abs_top_builddir"/src/config.sh])
AT_CHECK([grep -q "export ENTERPRISE_PATH=" "$abs_top_builddir"/src/config.sh])
AT_CHECK([grep -q "export NOVA_PATH=" "$abs_top_builddir"/src/config.sh])
AT_CHECK([grep -q "export MISSION_PORTAL_PATH=" "$abs_top_builddir"/src/config.sh])

AT_CHECK([test -n "$BASE_BRANCH"], 0)
AT_CHECK([grep -q "export CORE_BRANCH=" "$abs_top_builddir"/src/config.sh])
AT_CHECK([grep -q "export MASTERFILES_BRANCH=" "$abs_top_builddir"/src/config.sh])
AT_CHECK([grep -q "export ENTERPRISE_BRANCH=" "$abs_top_builddir"/src/config.sh])
AT_CHECK([grep -q "export NOVA_BRANCH=" "$abs_top_builddir"/src/config.sh])
AT_CHECK([grep -q "export MISSION_PORTAL_BRANCH=" "$abs_top_builddir"/src/config.sh])

AT_CHECK([test -n "$RSYNC"], 0)
AT_CHECK([test -n "$MAKE"], 0)
AT_CHECK([test -n "$FUSER"], 0)
AT_CHECK([test -n "$PATCH"], 0)

########################################
AT_CLEANUP
########################################
